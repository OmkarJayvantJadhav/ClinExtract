# Copy to .env.production (never commit it) and fill in every value.
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Public hostname. A real domain gets a Let's Encrypt certificate automatically; "localhost" uses a local CA.
SITE_ADDRESS=clinextract.example.org

# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
RABBITMQ_USER=clinextract
RABBITMQ_PASSWORD=
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe: without it stored documents and backups of them cannot be read.
DOCUMENT_ENCRYPTION_KEY=

# Purge finalized documents after N days (0 = keep forever)
DOCUMENT_RETENTION_DAYS=0
BACKUP_RETENTION_DAYS=14

# Optional: bearer token for the internal Prometheus scrape endpoint (/api/v1/health/metrics on backend:8000)
METRICS_TOKEN=

# Extraction: rule_based | llm | vlm. Gemini also requires ALLOW_EXTERNAL_AI_PHI=true (patient data
# leaves your infrastructure — only under an appropriate data-processing agreement).
EXTRACTION_PROVIDER=rule_based
ALLOW_EXTERNAL_AI_PHI=false
