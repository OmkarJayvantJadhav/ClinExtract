APP_NAME="ClinExtract API"
APP_ENV="development"
DEBUG=True
# Log every SQL statement (noisy; may write patient data to logs)
SQL_ECHO=False
DATABASE_URL="postgresql+psycopg://postgres:postgres@db:5432/clinextract"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'

# REQUIRED in production (the app refuses to start with the default). Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Review / processing behaviour
REVIEW_CLAIM_TIMEOUT_MINUTES=60
JOB_STALE_AFTER_MINUTES=15
MAX_DOCUMENT_PAGES=50

# Extraction configuration: rule_based | llm | vlm
EXTRACTION_PROVIDER=rule_based
EXTRACTION_FALLBACK_ENABLED=false

# Gemini (used when EXTRACTION_PROVIDER=llm with LLM_PROVIDER=gemini, or vlm with VLM_PROVIDER=gemini).
# NOTE: this sends document content (patient data) to Google. Only enable it under an
# appropriate data-processing agreement (e.g. a HIPAA BAA) for your deployment.
# LLM_PROVIDER=gemini
# LLM_MODEL=
# VLM_PROVIDER=gemini
# VLM_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
