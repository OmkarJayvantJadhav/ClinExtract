APP_NAME="ClinExtract API"
APP_ENV="development"
DEBUG=True
DATABASE_URL="postgresql+psycopg://postgres:postgres@db:5432/clinextract"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000"]'

# Extraction configuration
EXTRACTION_PROVIDER=rule_based
EXTRACTION_FALLBACK_ENABLED=false

